# Copy to .env for local development. In production these come from the platform environment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/node-ts-backend-starter
REDIS_URL=redis://localhost:6379

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Token lifetime with a unit: 900s, 15m, 12h, 1d. A bare number would be read as milliseconds.
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
# How long a user's role and account state stay cached; revocations clear it at once.
AUTH_CONTEXT_CACHE_TTL_SECONDS=60

# Failed sign-ins in a row that lock an email and IP pair, and for how long
LOGIN_MAX_CONSECUTIVE_FAILS=5
LOGIN_BLOCK_DURATION_SECONDS=900
# Failed sign-ins one IP may make per day, across all emails
LOGIN_MAX_FAILS_PER_IP_PER_DAY=100

# Comma-separated browser origins allowed to call the API, e.g. https://app.example.com
# Empty means any origin in development and none in production.
CORS_ORIGINS=

# Number of proxies in front of the app that append to X-Forwarded-For.
# 1 behind Cloud Run or a single load balancer, 2 behind an external load balancer + Cloud Run.
# Required in production.
TRUST_PROXY=false

RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SECONDS=60
USER_DELETION_RETENTION_DAYS=30
SHUTDOWN_TIMEOUT_MS=8000

# false on instances that only serve HTTP; background jobs then run on other instances
WORKERS_ENABLED=true
