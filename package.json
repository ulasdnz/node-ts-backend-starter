{
  "name": "node-ts-backend-starter",
  "version": "1.0.0",
  "description": "Production-ready Node.js REST API starter with TypeScript, Express, Mongoose, Redis, BullMQ, and i18n. Features advanced soft-delete architecture, background jobs, rate-limiting, and robust error handling.",
  "keywords": [
    "node",
    "express",
    "typescript",
    "mongoose",
    "boilerplate",
    "starter",
    "soft-delete",
    "bullmq",
    "redis",
    "i18n",
    "production-ready"
  ],
  "author": "Ulas Deniz Isik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulasdnz/node-ts-backend-starter.git"
  },
  "bugs": {
    "url": "https://github.com/ulasdnz/node-ts-backend-starter/issues"
  },
  "homepage": "https://github.com/ulasdnz/node-ts-backend-starter#readme",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "seed": "tsx --env-file-if-exists=.env src/database/seeders/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/database/migrations/index.ts",
    "migrate:prod": "node dist/database/migrations/index.js",
    "migration:create": "tsx src/scripts/create-migration.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "i18next": "^25.8.14",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-middleware": "^3.9.10",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "rate-limiter-flexible": "^9.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "type": "module"
}
